---
import '@/styles/global.css';
import { useTranslations, getHreflangLinks, type SupportedLanguage, defaultLang } from '@/i18n/utils';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';

export interface Props {
  lang?: SupportedLanguage;
  title?: string;
  description?: string;
}

const { lang = defaultLang, title, description } = Astro.props;
const t = useTranslations(lang);

const siteUrl = 'https://createqr.github.io';
const ogImageUrl = 'https://res.cloudinary.com/dpx6w78bt/image/upload/f_auto/q_auto/v1786342039/Online_Tool_rc1ybr.png';
const currentPath = Astro.url.pathname;
const pageTitle = title || t.site.title;
const pageDescription = description || t.site.description;
const canonicalUrl = new URL(currentPath, siteUrl).href;
const hreflangLinks = getHreflangLinks(siteUrl, currentPath);

// Structured Data Schema.org JSON-LD
const schemaGraph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      '@id': `${siteUrl}/#webapp`,
      name: 'CreateQR',
      url: canonicalUrl,
      applicationCategory: 'DesignApplication',
      operatingSystem: 'All',
      browserRequirements: 'Requires JavaScript. Requires HTML5 Canvas support.',
      image: ogImageUrl,
      offers: {
        '@type': 'Offer',
        price: '0',
        priceCurrency: 'USD',
      },
      description: pageDescription,
      featureList: [
        '100% Client-Side Privacy',
        '8 Standardized Data Types (URL, Wi-Fi, vCard, Text, Email, Phone, SMS, Crypto)',
        'Lossless Vector SVG Export',
        'High-Resolution Raster PNG/WEBP/JPEG Export up to 4096px',
        'Custom Dot Shapes, Corner Eye Patterns & Gradient Colors',
        'Center Logo & Icon Integration with Background Clearance',
        'Multi-Language Support (EN, ES, PT, DE, FR, JA)',
      ],
      author: {
        '@type': 'Person',
        name: 'Kishara Dilshan',
        url: 'https://buymeacoffee.com/kisharadilz',
      },
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${siteUrl}/#breadcrumbs`,
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: siteUrl,
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: pageTitle,
          item: canonicalUrl,
        },
      ],
    },
    {
      '@type': 'HowTo',
      '@id': `${siteUrl}/#howto`,
      name: t.howItWorks.heading,
      description: t.howItWorks.subheading,
      image: ogImageUrl,
      step: [
        {
          '@type': 'HowToStep',
          position: 1,
          name: t.howItWorks.step1Title,
          text: t.howItWorks.step1Desc,
        },
        {
          '@type': 'HowToStep',
          position: 2,
          name: t.howItWorks.step2Title,
          text: t.howItWorks.step2Desc,
        },
        {
          '@type': 'HowToStep',
          position: 3,
          name: t.howItWorks.step3Title,
          text: t.howItWorks.step3Desc,
        },
      ],
    },
    {
      '@type': 'FAQPage',
      '@id': `${siteUrl}/#faq`,
      mainEntity: [
        {
          '@type': 'Question',
          name: t.faq.q1,
          acceptedAnswer: {
            '@type': 'Answer',
            text: t.faq.a1,
          },
        },
        {
          '@type': 'Question',
          name: t.faq.q2,
          acceptedAnswer: {
            '@type': 'Answer',
            text: t.faq.a2,
          },
        },
        {
          '@type': 'Question',
          name: t.faq.q3,
          acceptedAnswer: {
            '@type': 'Answer',
            text: t.faq.a3,
          },
        },
        {
          '@type': 'Question',
          name: t.faq.q4,
          acceptedAnswer: {
            '@type': 'Answer',
            text: t.faq.a4,
          },
        },
        {
          '@type': 'Question',
          name: t.faq.q5,
          acceptedAnswer: {
            '@type': 'Answer',
            text: t.faq.a5,
          },
        },
        {
          '@type': 'Question',
          name: t.faq.q6,
          acceptedAnswer: {
            '@type': 'Answer',
            text: t.faq.a6,
          },
        },
      ],
    },
  ],
};
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    
    <!-- DNS Prefetch & Preconnect for High-Speed Asset Delivery -->
    <link rel="preconnect" href="https://res.cloudinary.com" crossorigin />
    <link rel="dns-prefetch" href="https://res.cloudinary.com" />
    <link rel="preconnect" href="https://www.googletagmanager.com" crossorigin />
    <link rel="dns-prefetch" href="https://www.googletagmanager.com" />

    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-W5ZZHJ34X0"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-W5ZZHJ34X0');
    </script>

    <!-- Anti-FOUC Theme Script -->
    <script is:inline>
      (function () {
        try {
          const storedTheme = localStorage.getItem('theme');
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (storedTheme === 'dark' || (!storedTheme && prefersDark)) {
            document.documentElement.classList.add('dark');
          } else {
            document.documentElement.classList.remove('dark');
          }
        } catch (e) {}
      })();
    </script>

    <!-- Primary Meta Tags -->
    <title>{pageTitle}</title>
    <meta name="title" content={pageTitle} />
    <meta name="description" content={pageDescription} />
    <meta name="keywords" content={t.site.keywords} />
    <meta name="author" content="Kishara Dilshan" />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="CreateQR" />

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalUrl} />

    <!-- 7 Bidirectional Hreflang Alternate Tags (including x-default) -->
    {
      hreflangLinks.map((item) => (
        <link rel="alternate" hreflang={item.lang} href={item.href} />
      ))
    }

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:site_name" content="CreateQR" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="CreateQR - Free Custom QR Code Generator & Designer" />
    <meta property="og:locale" content={lang} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="twitter:title" content={pageTitle} />
    <meta property="twitter:description" content={pageDescription} />
    <meta property="twitter:image" content={ogImageUrl} />
    <meta property="twitter:image:alt" content="CreateQR - Free Custom QR Code Generator & Designer" />

    <!-- Favicon & Theme Color -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" type="image/x-icon" href="/favicon.ico" />
    <meta name="theme-color" content="#FE7F2D" />

    <!-- Structured Data JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />
  </head>
  <body class="bg-[#EAECF0] text-[#000000] dark:bg-[#0a1117] dark:text-[#EAECF0] min-h-screen flex flex-col selection:bg-[#FE7F2D] selection:text-white transition-colors duration-200">
    <Header lang={lang} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
