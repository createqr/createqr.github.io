---
import { useTranslations, type SupportedLanguage } from '@/i18n/utils';

export interface Props {
  lang: SupportedLanguage;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const steps = [
  {
    step: '01',
    title: t.howItWorks.step1Title,
    desc: t.howItWorks.step1Desc,
    icon: `<svg class="w-7 h-7 text-brand-500 dark:text-brand-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>`,
  },
  {
    step: '02',
    title: t.howItWorks.step2Title,
    desc: t.howItWorks.step2Desc,
    icon: `<svg class="w-7 h-7 text-indigo-600 dark:text-indigo-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="m4.93 4.93 4.24 4.24"/><path d="m14.83 9.17 4.24-4.24"/><path d="m14.83 14.83 4.24 4.24"/><path d="m9.17 14.83-4.24 4.24"/><circle cx="12" cy="12" r="4"/></svg>`,
  },
  {
    step: '03',
    title: t.howItWorks.step3Title,
    desc: t.howItWorks.step3Desc,
    icon: `<svg class="w-7 h-7 text-emerald-600 dark:text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>`,
  },
];
---

<section id="how-it-works" class="py-16 sm:py-24 bg-slate-100/50 dark:bg-slate-900/30 border-y border-slate-200/60 dark:border-slate-800/60 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center max-w-3xl mx-auto mb-12 sm:mb-16">
      <span class="text-xs font-extrabold uppercase tracking-widest text-brand-500 dark:text-brand-400 mb-2 block">
        Simple 3-Step Process
      </span>
      <h2 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-slate-900 dark:text-white">
        {t.howItWorks.heading}
      </h2>
      <p class="mt-4 text-base sm:text-lg text-slate-600 dark:text-slate-400">
        {t.howItWorks.subheading}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 relative">
      {
        steps.map((item, index) => (
          <div class="relative flex flex-col p-8 rounded-3xl glass-panel shadow-sm hover:shadow-md transition-shadow">
            <div class="flex items-center justify-between mb-6">
              <div class="p-3.5 rounded-2xl bg-brand-50 dark:bg-brand-950/50 border border-brand-100 dark:border-[#233D4D]/60">
                <Fragment set:html={item.icon} />
              </div>
              <span class="text-3xl font-black text-slate-300 dark:text-slate-700 font-mono">
                {item.step}
              </span>
            </div>
            <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-2">
              {item.title}
            </h3>
            <p class="text-sm leading-relaxed text-slate-600 dark:text-slate-400 flex-1">
              {item.desc}
            </p>
          </div>
        ))
      }
    </div>

  </div>
</section>
